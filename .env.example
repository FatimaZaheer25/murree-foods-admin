# Copy to .env.local for local development.

# Where the browser sends API calls.
#   Local:  http://localhost:5000/api  (straight to the backend)
#   Vercel: /api                       (same domain, through the rewrite in next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Where /api/* is forwarded on Vercel. No /api, no trailing slash.
BACKEND_URL=http://localhost:5000

# Addresses of the three apps, for links between them ("Back to site", old dish photos, wrong-app links).
# No trailing slash. On Vercel use the real addresses.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_RIDER_URL=http://localhost:3002
